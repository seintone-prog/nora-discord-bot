
const {
  Client,
  GatewayIntentBits,
  EmbedBuilder,
  ActionRowBuilder,
  ButtonBuilder,
  ButtonStyle
} = require("discord.js");

const http = require("node:http");

// ================= CONFIG =================

const TOKEN = process.env.DISCORD_TOKEN;
const OWNER_ID = process.env.OWNER_ID;

const API = (
  process.env.NORA_API_URL ||
  process.env.API_URL ||
  ""
).replace(/\/+$/, "");

const SECRET =
  process.env.NORA_API_SECRET ||
  process.env.API_SECRET;

const PORT = Number(process.env.PORT || 3000);

if (!TOKEN || !OWNER_ID || !API || !SECRET) {
  console.error("Missing required environment variables.");
  process.exit(1);
}

// ================= HTTP SERVER =================

let dbLoaded = false;
let botReady = false;

const server = http.createServer((req, res) => {
  res.setHeader("Content-Type", "application/json");
  res.setHeader("Cache-Control", "no-store");

  if (req.method === "GET" && req.url === "/health") {
    const status = botReady && dbLoaded;

    res.writeHead(status ? 200 : 503);
    return res.end(JSON.stringify({
      ok: status,
      service: "Nora Discord Bot",
      bot: botReady ? "online" : "offline",
      database: dbLoaded ? "connected" : "loading"
    }));
  }

  if (req.method === "GET" && req.url === "/") {
    res.writeHead(200);
    return res.end(JSON.stringify({
      service: "Nora Discord Bot",
      status: "running",
      bot: botReady ? "online" : "starting"
    }));
  }

  res.writeHead(404);
  res.end(JSON.stringify({ error: "Not found" }));
});

server.listen(PORT, "0.0.0.0", () => {
  console.log("Nora HTTP server listening on port " + PORT);
});

// ================= CONFIGURATION =================

const aliases = {
  nw: "wallet",
  np: "profile",
  nd: "daily",
  nc: "cards",
  ni: "inventory",
  ns: "summon",
  nq: "quest",
  nb: "battle",
  nm: "market",
  nlb: "leaderboard"
};

const rarityWeight = {
  Common: 45,
  Rare: 28,
  Epic: 16,
  Legendary: 7,
  Mythic: 3,
  Limited: 1
};

const rarityColor = {
  Common: 0x9ca3af,
  Rare: 0x3b82f6,
  Epic: 0xa855f7,
  Legendary: 0xf59e0b,
  Mythic: 0xec4899,
  Limited: 0xef4444
};

const defaults = {
  players: {},
  cards: [],
  market: [],
  settings: {
    maintenance: false,
    event: "ပုံမှန် Event"
  },
  logs: []
};

let db;
let saveQueue = Promise.resolve();

// ================= DATABASE API =================

async function api(method = "GET", body) {
  const res = await fetch(API + "/state", {
    method,
    headers: {
      "X-API-Key": SECRET,
      "Content-Type": "application/json"
    },
    body: body ? JSON.stringify(body) : undefined
  });

  if (!res.ok) {
    throw new Error(
      "Nora API " + res.status + ": " +
      (await res.text()).slice(0, 300)
    );
  }

  return res.json();
}

async function load() {
  const data = await api("GET");

  db = {
    ...defaults,
    ...data,
    players: data.players || {},
    cards: Array.isArray(data.cards) ? data.cards : [],
    market: Array.isArray(data.market) ? data.market : [],
    settings: {
      ...defaults.settings,
      ...(data.settings || {})
    },
    logs: Array.isArray(data.logs) ? data.logs : []
  };

  dbLoaded = true;
  console.log("Nora D1 state loaded");
}

function save() {
  const snapshot = JSON.parse(JSON.stringify(db));

  saveQueue = saveQueue
    .then(() => api("PUT", snapshot))
    .catch(err => {
      console.error("D1 save failed:", err);
    });

  return saveQueue;
}

// ================= PLAYER SYSTEM =================

function getPlayer(id, name) {
  if (!db.players[id]) {
    db.players[id] = {
      id,
      username: name,
      coins: 500,
      xp: 0,
      level: 1,
      cards: {},
      pity: 0,
      lastDaily: 0,
      streak: 0,
      wins: 0,
      losses: 0,
      quests: {
        daily: 0,
        lastReset: new Date().toISOString().slice(0, 10)
      }
    };
  }

  db.players[id].username = name;
  return db.players[id];
}

function addXP(p, amount) {
  p.xp += amount;
  let levels = 0;

  while (p.xp >= p.level * 100) {
    p.xp -= p.level * 100;
    p.level++;
    p.coins += 100;
    levels++;
  }

  return levels;
}

function giveCard(p, card) {
  p.cards[card.id] = (p.cards[card.id] || 0) + 1;
}

function pick(list) {
  if (!list.length) return null;

  const total = list.reduce(
    (sum, card) => sum + (rarityWeight[card.rarity] || 0),
    0
  );

  if (total <= 0) {
    return list[Math.floor(Math.random() * list.length)];
  }

  let roll = Math.random() * total;

  for (const card of list) {
    roll -= rarityWeight[card.rarity] || 0;
    if (roll < 0) return card;
  }

  return list[list.length - 1];
}

// ================= EMBEDS =================

function embed(title, description, color = 0xffb6d9) {
  return new EmbedBuilder()
    .setColor(color)
    .setTitle(title)
    .setDescription(description)
    .setFooter({
      text: "Nora • Cute Anime Game World 🌸"
    })
    .setTimestamp();
}

function isOwner(message) {
  return message.author.id === OWNER_ID;
}

function logOwner(action, message, target, detail) {
  db.logs.push({
    at: new Date().toISOString(),
    action,
    actor: message.author.id,
    target,
    detail
  });

  if (db.logs.length > 300) {
    db.logs.shift();
  }
}

// ================= COMMAND HANDLER =================

async function runCommand(message) {
  if (message.author.bot || !message.guild) return;

  const content = message.content.trim();

  let commandText = "";

  if (/^n[a-z]+(?:\s|$)/i.test(content)) {
    commandText = content;
  } else if (/^n\s+/i.test(content)) {
    commandText = content.slice(1).trim();
  } else {
    return;
  }

  const args = commandText.split(/\s+/);
  let command = (args.shift() || "").toLowerCase();

  if (!command) return;

  command = aliases[command] || command;

  try {
    const p = getPlayer(
      message.author.id,
      message.author.username
    );

    if (
      db.settings.maintenance &&
      !isOwner(message) &&
      command !== "help"
    ) {
      return message.reply(
        "🛠️ Nora ကို ပြုပြင်ထိန်းသိမ်းနေပါတယ်။ ခဏနေရင် ပြန်လာခဲ့ပါ။"
      );
    }

    // HELP

    if (command === "help") {
      const e = embed(
        "🌸 Nora — Game Help",
        "Nora Game World မှာ ကြိုဆိုပါတယ်။"
      ).addFields(
        {
          name: "💰 Economy",
          value: "`n wallet` / `nw` · `n daily` / `nd`",
          inline: true
        },
        {
          name: "👤 Player",
          value: "`n profile` / `np` · `n leaderboard` / `nlb`",
          inline: true
        },
        {
          name: "🃏 Cards",
          value: "`n cards` / `nc` · `n inventory` / `ni` · `n card ID`",
          inline: true
        },
        {
          name: "✨ Summon",
          value: "`n summon` / `ns` · `n summon 10`",
          inline: true
        },
        {
          name: "⚔️ Game",
          value: "`n quest` / `nq` · `n battle` / `nb`",
          inline: true
        },
        {
          name: "🛒 Market",
          value: "`n market` / `nm` · `n sell ID PRICE` · `n buy ID`",
          inline: true
        }
      );

      const row = new ActionRowBuilder().addComponents(
        new ButtonBuilder()
          .setCustomId("nora_cards")
          .setLabel("Cards")
          .setEmoji("🃏")
          .setStyle(ButtonStyle.Secondary),

        new ButtonBuilder()
          .setCustomId("nora_games")
          .setLabel("Games")
          .setEmoji("🎮")
          .setStyle(ButtonStyle.Primary)
      );

      return message.reply({
        embeds: [e],
        components: [row]
      });
    }

    // WALLET

    if (command === "wallet") {
      return message.reply({
        embeds: [
          embed(
            "💰 Player Wallet",
            `👤 ${p.username}\n🪙 Coins: **${p.coins.toLocaleString()}**`,
            0xfbbf24
          )
        ]
      });
    }

    // PROFILE

    if (command === "profile") {
      const count = Object.values(p.cards)
        .reduce((a, b) => a + b, 0);

      return message.reply({
        embeds: [
          embed(
            "👤 Player Profile",
            `🌸 **${p.username}**
⭐ Level: **${p.level}**
✨ XP: **${p.xp}/${p.level * 100}**
🪙 Coins: **${p.coins.toLocaleString()}**
🃏 Cards: **${count}**
⚔️ Wins/Losses: **${p.wins}/${p.losses}**`
          )
        ]
      });
    }

    // DAILY

    if (command === "daily") {
      const now = Date.now();
      const left = 86400000 - (now - p.lastDaily);

      if (left > 0) {
        return message.reply(
          `⏳ နောက် Daily Reward ကို **${Math.floor(left / 3600000)} နာရီ ${Math.floor(left % 3600000 / 60000)} မိနစ်** ကြာမှ ယူနိုင်ပါတယ်။`
        );
      }

      const reward = 250 + Math.min(p.streak, 7) * 25;

      p.coins += reward;
      p.lastDaily = now;
      p.streak++;

      const levels = addXP(p, 25);
      await save();

      return message.reply({
        embeds: [
          embed(
            "🎁 Daily Reward ရပါပြီ!",
            `🪙 +${reward} Coins
✨ +25 XP
🔥 Streak: ${p.streak}${levels ? "\n⭐ Level Up!" : ""}`,
            0x34d399
          )
        ]
      });
    }

    // CARDS

    if (command === "cards") {
      const description = db.cards.map(card =>
        `**${card.id}** — ${card.name} · ${card.rarity} · ⚔️ ${card.power}`
      ).join("\n");

      return message.reply({
        embeds: [
          embed(
            "🃏 Nora Card Collection",
            description || "Card မရှိသေးပါ။"
          )
        ]
      });
    }

    // CARD DETAIL

    if (command === "card") {
      const card = db.cards.find(
        x => x.id === (args[0] || "").toUpperCase()
      );

      if (!card) {
        return message.reply("❌ Card ID မတွေ့ပါ။ `nc` ကို ကြည့်ပါ။");
      }

      const e = embed(
        "🃏 " + card.name,
        `ID: ${card.id}
Rarity: **${card.rarity}**
Power: **${card.power}**
Ability: ${card.ability || "မရှိသေးပါ"}
ပိုင်ဆိုင်မှု: **${p.cards[card.id] || 0}**`,
        rarityColor[card.rarity] || 0xffb6d9
      );

      if (card.image) e.setImage(card.image);

      return message.reply({ embeds: [e] });
    }

    // INVENTORY

    if (command === "inventory") {
      const owned = Object.entries(p.cards)
        .filter(([, count]) => count > 0);

      if (!owned.length) {
        return message.reply(
          "🎒 Card မရှိသေးပါ။ `ns` နဲ့ Summon လုပ်ပါ။"
        );
      }

      const description = owned.map(([id, count]) => {
        const card = db.cards.find(x => x.id === id);

        return `**${id}** ${card?.name || "Unknown"} ×${count}`;
      }).join("\n");

      return message.reply({
        embeds: [
          embed("🎒 Your Card Inventory", description)
        ]
      });
    }

    // SUMMON

    if (command === "summon") {
      const amount = Number(args[0] || 1);

      if (![1, 10].includes(amount)) {
        return message.reply(
          "အသုံးပြုပုံ: `ns` သို့မဟုတ် `ns 10`"
        );
      }

      if (!db.cards.length) {
        return message.reply(
          "❌ Card Database မရှိသေးပါ။ Owner ကို အသိပေးပါ။"
        );
      }

      const cost = amount === 1 ? 1000 : 9000;

      if (p.coins < cost) {
        return message.reply(
          `🪙 Coin မလုံလောက်ပါ။ လိုအပ်ချက် **${cost.toLocaleString()} Coins**`
        );
      }

      p.coins -= cost;

      const results = [];

      for (let i = 0; i < amount; i++) {
        p.pity++;

        let card = pick(db.cards);

        if (p.pity >= 80) {
          const high = db.cards.filter(x =>
            ["Legendary", "Mythic", "Limited"].includes(x.rarity)
          );

          if (high.length) {
            card = pick(high);
            p.pity = 0;
          }
        } else if (
          p.pity >= 30 &&
          ["Common", "Rare"].includes(card.rarity)
        ) {
          const mid = db.cards.filter(x =>
            ["Epic", "Legendary", "Mythic", "Limited"].includes(x.rarity)
          );

          if (mid.length) {
            card = pick(mid);
            p.pity = 0;
          }
        } else if (
          ["Legendary", "Mythic", "Limited"].includes(card.rarity)
        ) {
          p.pity = 0;
        }

        giveCard(p, card);
        results.push(card);
      }

      await save();

      const best = results.reduce((a, b) =>
        (rarityWeight[a.rarity] || 0) <
        (rarityWeight[b.rarity] || 0) ? a : b
      );

      return message.reply({
        embeds: [
          embed(
            "✨ Summon Result",
            `🪙 အသုံးပြု: **${cost.toLocaleString()}**
${results.map((card, i) =>
  `**${i + 1}. ${card.name}** · ${card.rarity} · \`${card.id}\``
).join("\n")}

💰 လက်ကျန်: **${p.coins.toLocaleString()}**`,
            rarityColor[best.rarity] || 0xffb6d9
          )
        ]
      });
    }

    // QUEST

    if (command === "quest") {
      const today = new Date().toISOString().slice(0, 10);

      if (p.quests.lastReset !== today) {
        p.quests = {
          daily: 0,
          lastReset: today
        };
      }

      if (p.quests.daily >= 3) {
        return message.reply(
          "📜 ဒီနေ့ Quest ၃ ခု ပြီးပါပြီ။ မနက်ဖြန် ပြန်လာခဲ့ပါ။"
        );
      }

      p.quests.daily++;
      p.coins += 150;

      const levels = addXP(p, 35);
      await save();

      return message.reply({
        embeds: [
          embed(
            "📜 Daily Quest Complete",
            `🪙 +150 Coins
✨ +35 XP
Quest: **${p.quests.daily}/3**${levels ? "\n⭐ Level Up!" : ""}`,
            0x34d399
          )
        ]
      });
    }

    // BATTLE

    if (command === "battle") {
      const owned = Object.entries(p.cards)
        .filter(([, count]) => count > 0);

      if (!owned.length) {
        return message.reply(
          "⚔️ အရင်ဆုံး `ns` နဲ့ Card တစ်ကတ် Summon လုပ်ပါ။"
        );
      }

      const [id] = owned[
        Math.floor(Math.random() * owned.length)
      ];

      const card = db.cards.find(x => x.id === id);

      if (!card) {
        return message.reply("❌ သင့် Card ကို Database မှာ မတွေ့ပါ။");
      }

      const enemy = 10 + Math.floor(Math.random() * 65);
      const power = (card.power || 10) + p.level * 2;
      const win = power >= enemy;

      if (win) {
        p.wins++;
        p.coins += 200;
        addXP(p, 40);
      } else {
        p.losses++;
        p.coins += 50;
        addXP(p, 15);
      }

      await save();

      return message.reply({
        embeds: [
          embed(
            win ? "🏆 Battle အနိုင်ရပါပြီ!" : "⚔️ ဒီတစ်ကြိမ် ရှုံးနိမ့်သွားပါတယ်",
            `🃏 Card: **${card.name}**
💪 သင့် Power: **${power}**
👾 Enemy Power: **${enemy}**
${win ? "🪙 +200 Coins · +40 XP" : "🪙 +50 Coins · +15 XP"}`,
            win ? 0x34d399 : 0xf59e0b
          )
        ]
      });
    }

    // LEADERBOARD

    if (command === "leaderboard") {
      const top = Object.values(db.players)
        .sort((a, b) =>
          b.level - a.level || b.coins - a.coins
        )
        .slice(0, 10);

      return message.reply({
        embeds: [
          embed(
            "🏆 Nora Leaderboard",
            top.map((x, i) =>
              `**${i + 1}. ${x.username}** — Lv.${x.level} · 🪙 ${x.coins.toLocaleString()}`
            ).join("\n") || "Player မရှိသေးပါ။"
          )
        ]
      });
    }

    // MARKET

    if (command === "market") {
      if (!db.market.length) {
        return message.reply("🛒 Market မှာ Card မရှိသေးပါ။");
      }

      return message.reply({
        embeds: [
          embed(
            "🛒 Nora Market",
            db.market.slice(0, 15).map(x =>
              `**${x.cardId}** ${x.cardName} · 🪙 ${x.price} · <@${x.seller}> · ID \`${x.listingId}\``
            ).join("\n")
          )
        ]
      });
    }

    // SELL

    if (command === "sell") {
      const id = (args[0] || "").toUpperCase();
      const price = Number(args[1]);

      const card = db.cards.find(x => x.id === id);

      if (
        !card ||
        !Number.isSafeInteger(price) ||
        price < 1 ||
        price > 1000000
      ) {
        return message.reply(
          "အသုံးပြုပုံ: `n sell CARD_ID PRICE`"
        );
      }

      if ((p.cards[id] || 0) < 1) {
        return message.reply("❌ ဒီ Card ကို မပိုင်ဆိုင်ပါ။");
      }

      p.cards[id]--;

      const listingId =
        "M" + Date.now().toString(36).toUpperCase();

      db.market.push({
        listingId,
        cardId: id,
        cardName: card.name,
        seller: message.author.id,
        price
      });

      await save();

      return message.reply(
        `🛒 ${card.name} ကို ${price} Coins နဲ့ တင်ပြီးပါပြီ။ ID: \`${listingId}\``
      );
    }

    // BUY

    if (command === "buy") {
      const ix = db.market.findIndex(
        x => x.listingId === args[0]
      );

      if (ix < 0) {
        return message.reply("❌ Listing ID မတွေ့ပါ။");
      }

      const item = db.market[ix];

      if (item.seller === message.author.id) {
        return message.reply("ကိုယ့် Card ကို ကိုယ်ပြန်ဝယ်လို့မရပါ။");
      }

      if (p.coins < item.price) {
        return message.reply("🪙 Coin မလုံလောက်ပါ။");
      }

      const card = db.cards.find(
        x => x.id === item.cardId
      );

      if (!card) {
        return message.reply("❌ ဒီ Card မရှိတော့ပါ။");
      }

      const seller = getPlayer(
        item.seller,
        db.players[item.seller]?.username || "Player"
      );

      p.coins -= item.price;
      seller.coins += item.price;

      giveCard(p, card);

      db.market.splice(ix, 1);

      await save();

      return message.reply(
        "✅ " + item.cardName + " ကို ဝယ်ယူပြီးပါပြီ။"
      );
    }

    // OWNER COMMANDS

    if (command === "owner") {
      if (!isOwner(message)) {
        return message.reply("🔒 Owner သာ အသုံးပြုနိုင်ပါတယ်။");
      }

      const sub = (args.shift() || "").toLowerCase();

      if (["addcoins", "removecoins", "setcoins"].includes(sub)) {
        const id = args[0];
        const amount = Number(args[1]);

        if (
          !id ||
          !Number.isSafeInteger(amount) ||
          amount < 0 ||
          amount > 1e9
        ) {
          return message.reply(
            "အသုံးပြုပုံ: n owner addcoins USER_ID AMOUNT"
          );
        }

        const target = getPlayer(
          id,
          db.players[id]?.username || "Player"
        );

        if (sub === "addcoins") target.coins += amount;

        if (sub === "removecoins") {
          target.coins = Math.max(0, target.coins - amount);
        }

        if (sub === "setcoins") target.coins = amount;

        logOwner(sub, message, id, amount);
        await save();

        return message.reply(
          `🔐 ${id} Coin: **${target.coins.toLocaleString()}**`
        );
      }

      if (sub === "givecard") {
        const id = args[0];

        const card = db.cards.find(
          x => x.id === (args[1] || "").toUpperCase()
        );

        if (!id || !card) {
          return message.reply(
            "အသုံးပြုပုံ: n owner givecard USER_ID CARD_ID"
          );
        }

        giveCard(
          getPlayer(
            id,
            db.players[id]?.username || "Player"
          ),
          card
        );

        logOwner(sub, message, id, card.id);
        await save();

        return message.reply(
          "🔐 " + card.name + " ပေးပြီးပါပြီ။"
        );
      }

      if (sub === "maintenance") {
        db.settings.maintenance = args[0] === "on";

        logOwner(
          sub,
          message,
          "all",
          db.settings.maintenance
        );

        await save();

        return message.reply(
          "🛠️ Maintenance: " +
          (db.settings.maintenance ? "ON" : "OFF")
        );
      }

      if (sub === "backup") {
        await save();
        return message.reply(
          "💾 D1 Database မှာ Save ပြီးပါပြီ။"
        );
      }

      return message.reply(
        "Owner: addcoins/removecoins/setcoins USER_ID AMOUNT, givecard USER_ID CARD_ID, maintenance on/off, backup"
      );
    }

    return message.reply
